// FlowBoard - סכמת Prisma
// בכל טבלה ששייכת לארגון יש organizationId (ישירות או דרך טבלת האב),
// כדי להפריד בין הנתונים של ארגונים שונים.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- ערכים סגורים (Enums) ----------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationPlan {
  FREE
  TEAM
  BUSINESS
}

enum RoleName {
  EMPLOYEE
  PROJECT_MANAGER
  ORG_ADMIN
  SYSTEM_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  AT_RISK
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProjectMemberRole {
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum TaskStatusCategory {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DependencyType {
  BLOCKS
  RELATES_TO
}

enum NotificationType {
  TASK_ASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  DUE_SOON
  OVERDUE
  MEMBER_ADDED
  AUTOMATION_TRIGGERED
  MEETING_INVITE
}

// ---------- ארגון ----------

model Organization {
  id         String             @id @default(uuid())
  name       String
  slug       String             @unique
  status     OrganizationStatus @default(ACTIVE)
  plan       OrganizationPlan   @default(FREE)
  brandColor String?
  tagline    String?
  createdAt  DateTime           @default(now())

  users           User[]
  userRoles       UserRole[]
  projects        Project[]
  labels          Label[]
  notifications   Notification[]
  automationRules AutomationRule[]
  auditLogEntries AuditLogEntry[]

  rolePermissionChanges OrganizationRolePermission[]
  userPermissionChanges UserPermissionOverride[]
  decisions             Decision[]

  @@map("organizations")
}

// ---------- תפקידים והרשאות ----------

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  label       String
  description String

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// שינוי שארגון עשה באחת מהרשאות ברירת המחדל של תפקיד (ברירות המחדל נמצאות בקובץ
// src/permissions/catalog.js). granted = true מוסיף את ההרשאה לתפקיד, false מסיר אותה.
model OrganizationRolePermission {
  id             String   @id @default(uuid())
  organizationId String
  roleName       RoleName
  permissionKey  String
  granted        Boolean
  updatedById    String
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, roleName, permissionKey])
  @@map("organization_role_permissions")
}

// חריג הרשאה לעובד אחד, מעבר לתפקידים שלו: granted = true נותן הרשאה נוספת,
// false שולל הרשאה. לא בתוקף אחרי expiresAt (אם הוגדר).
model UserPermissionOverride {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  permissionKey  String
  granted        Boolean
  expiresAt      DateTime?
  reason         String?
  grantedById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("PermissionOverrideFor", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User         @relation("PermissionOverrideBy", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@index([organizationId])
  @@map("user_permission_overrides")
}

model UserRole {
  id             String @id @default(uuid())
  userId         String
  roleId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([organizationId])
  @@map("user_roles")
}

// ---------- משתמשים והתחברות ----------

model User {
  id                  String     @id @default(uuid())
  organizationId      String
  firstName           String
  lastName            String
  email               String     @unique
  passwordHash        String
  avatarColor         String
  title               String
  status              UserStatus @default(ACTIVE)
  lastActiveAt        DateTime   @default(now())
  createdAt           DateTime   @default(now())
  defaultRole         RoleName   @default(EMPLOYEE)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  deletedAt           DateTime?

  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  refreshTokens RefreshToken[]

  managedProjects    Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]
  createdTasks       Task[]          @relation("TaskCreator")
  assignedTasks      Task[]          @relation("TaskAssignee")
  comments           Comment[]
  attachments        Attachment[]
  activityEntries    ActivityEntry[]
  notifications      Notification[]
  auditLogEntries    AuditLogEntry[]

  permissionOverrides       UserPermissionOverride[] @relation("PermissionOverrideFor")
  grantedPermissionOverrides UserPermissionOverride[] @relation("PermissionOverrideBy")
  decisions                  Decision[]               @relation("DecisionsMade")

  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- פרויקטים ----------

model Project {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String
  status         ProjectStatus @default(PLANNING)
  managerId      String
  startDate      DateTime
  targetDate     DateTime
  progress       Int           @default(0)
  createdAt      DateTime      @default(now())
  archived       Boolean       @default(false)
  riskScore      Int           @default(0)
  riskLevel      RiskLevel     @default(LOW)
  riskFactors    Json          @default("[]")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager         User            @relation("ProjectManager", fields: [managerId], references: [id])
  members         ProjectMember[]
  board           Board?
  tasks           Task[]
  attachments     Attachment[]
  auditLogEntries AuditLogEntry[]
  riskSnapshots   ProjectRiskSnapshot[]
  decisions       Decision[]

  @@index([organizationId])
  @@map("projects")
}

model ProjectMember {
  projectId     String
  userId        String
  roleOnProject ProjectMemberRole @default(CONTRIBUTOR)
  joinedAt      DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model Board {
  id        String @id @default(uuid())
  projectId String @unique
  name      String

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]

  @@map("boards")
}

model BoardColumn {
  id       String             @id @default(uuid())
  boardId  String
  name     String
  category TaskStatusCategory
  order    Int
  wipLimit Int?

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
  @@map("board_columns")
}

model Label {
  id             String @id @default(uuid())
  organizationId String
  name           String
  color          String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskLabels   TaskLabel[]

  @@index([organizationId])
  @@map("labels")
}

// ---------- משימות ----------

model Task {
  id             String       @id @default(uuid())
  projectId      String
  columnId       String
  title          String
  description    String
  assigneeId     String?
  creatorId      String
  priority       TaskPriority @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float?
  blocked        Boolean      @default(false)
  archived       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?
  parentTaskId   String?

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column     BoardColumn @relation(fields: [columnId], references: [id])
  assignee   User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator    User        @relation("TaskCreator", fields: [creatorId], references: [id])
  parentTask Task?       @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[]      @relation("TaskSubtasks")

  labels               TaskLabel[]
  dependsOn            TaskDependency[]          @relation("DependentTask")
  dependedOnBy         TaskDependency[]          @relation("DependsOnTask")
  comments             Comment[]
  attachments          Attachment[]
  activityEntries      ActivityEntry[]
  notifications        Notification[]
  auditLogEntries      AuditLogEntry[]
  automationFirings    AutomationRuleFiring[]
  automationExecutions AutomationRuleExecution[]
  statusChanges        TaskStatusChange[]

  @@index([projectId])
  @@index([columnId])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@map("tasks")
}

// כל כניסה של משימה לעמודה בלוח (כולל העמודה שבה נוצרה), כדי שאפשר יהיה למדוד
// כמה זמן עבודה ממתינה בכל שלב. שמות העמודות מועתקים לכאן, כך שההיסטוריה
// נשמרת גם אם משנים שם של עמודה או מוחקים אותה.
model TaskStatusChange {
  id             String             @id @default(uuid())
  taskId         String
  projectId      String
  fromColumnName String?
  toColumnName   String
  toCategory     TaskStatusCategory
  actorId        String?
  changedAt      DateTime           @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, changedAt])
  @@index([projectId])
  @@map("task_status_changes")
}

// החלטת ניהול שהתקבלה במסך התכנון (סימולטור או המלצה):
// מה השתנה, מה היו הסיכון והצפי של הפרויקט באותו רגע, ומה המודל חזה -
// כדי שאפשר יהיה למדוד מאוחר יותר את ההשפעה בפועל.
model Decision {
  id                String   @id @default(uuid())
  organizationId    String
  projectId         String
  actorId           String
  source            String // 'SIMULATOR' | 'RECOMMENDATION'
  title             String
  changes           Json // שינויי ה"מה אם" שבוצעו
  summary           Json // רשימת השינויים בניסוח קריא
  note              String?
  riskBefore        Int
  riskPredicted     Int
  daysLateBefore    Int?
  daysLatePredicted Int?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor        User         @relation("DecisionsMade", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@map("decisions")
}

// ציון סיכון אחד לכל פרויקט לכל יום, כדי להציג את הסיכון כמגמה.
model ProjectRiskSnapshot {
  id        String    @id @default(uuid())
  projectId String
  day       DateTime  @db.Date
  riskScore Int
  riskLevel RiskLevel

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, day])
  @@map("project_risk_snapshots")
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model TaskDependency {
  taskId          String
  dependsOnTaskId String
  type            DependencyType @default(BLOCKS)

  task          Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("DependsOnTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model Comment {
  id        String    @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@map("comments")
}

model Attachment {
  id           String   @id @default(uuid())
  taskId       String?
  projectId    String?
  fileName     String
  fileType     String
  sizeKb       Int
  storageKey   String
  uploadedById String
  uploadedAt   DateTime @default(now())

  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@map("attachments")
}

model ActivityEntry {
  id        String   @id @default(uuid())
  taskId    String
  actorId   String
  action    String
  detail    String
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId])
  @@map("activity_entries")
}

// ---------- התראות ----------

model Notification {
  id               String           @id @default(uuid())
  organizationId   String
  userId           String
  type             NotificationType
  title            String
  body             String
  read             Boolean          @default(false)
  createdAt        DateTime         @default(now())
  relatedProjectId String?
  relatedTaskId    String?
  // קישור שההתראה מפנה אליו, למשל קישור ההצטרפות לפגישת Zoom.
  actionUrl        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedTask  Task?        @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@map("notifications")
}

// ---------- אוטומציה ----------

model AutomationRule {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  enabled        Boolean  @default(true)
  trigger        Json
  condition      Json?
  action         Json
  createdAt      DateTime @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firedFor     AutomationRuleFiring[]
  executions   AutomationRuleExecution[]

  @@index([organizationId])
  @@map("automation_rules")
}

model AutomationRuleExecution {
  id        String   @id @default(uuid())
  ruleId    String
  taskId    String?
  status    String
  message   String?
  createdAt DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  task Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([ruleId, createdAt])
  @@map("automation_rule_executions")
}

// רושם שחוק כבר רץ על משימה, כדי שטריגרים של סריקה תקופתית
// (TASK_OVERDUE, DUE_DATE_APPROACHING) ירוצו פעם אחת לכל משימה ולא ישלחו התראה בכל
// סריקה כל עוד המשימה באיחור. טריגרים של אירוע (STATUS_ENTERED)
// לא צריכים את זה - כל הזזה היא אירוע נפרד.
model AutomationRuleFiring {
  id      String   @id @default(uuid())
  ruleId  String
  taskId  String
  firedAt DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  task Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([ruleId, taskId])
  @@map("automation_rule_firings")
}

// ---------- יומן ביקורת ----------

model AuditLogEntry {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String
  action         String
  entityType     String
  entityId       String
  createdAt      DateTime @default(now())
  metadata       Json     @default("{}")

  // קשרים אופציונליים לנוחות השליפה - היומן עצמו לא תלוי בהם.
  projectId String?
  taskId    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_log_entries")
}
