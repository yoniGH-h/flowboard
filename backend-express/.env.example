# יש להעתיק ל-.env ולהתאים לסביבה המקומית. לעולם לא לשמור את קובץ ה-.env האמיתי ב-Git.

# מסד נתונים משלו (flowboard_express) ב-Postgres המקומי.
DATABASE_URL="postgresql://flowboard:flowboard@localhost:5433/flowboard_express?schema=public"

PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# סודות ה-JWT - מחוץ לפיתוח מקומי יש ליצור ערכים אקראיים אמיתיים,
# למשל: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# אחסון מקומי של הקבצים שמצורפים למשימות
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# שיחות קוליות ופגישות Zoom (אופציונלי). יוצרים אפליקציית "Server-to-Server OAuth" באתר
# https://marketplace.zoom.us עם ההרשאה meeting:write ומדביקים כאן את המפתחות שלה.
# כשהשדות ריקים השיחות כבויות (והכפתורים מסבירים ש-Zoom לא הוגדר).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
