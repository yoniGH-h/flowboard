# Copy to .env and adjust for your local setup. Never commit the real .env file.

# Its own database (flowboard_express) on the same local Postgres as the other backends.
# The C# backend stores enums as text while Prisma uses Postgres enum types, so the two
# cannot share one database.
DATABASE_URL="postgresql://flowboard:flowboard@localhost:5433/flowboard_express?schema=public"

PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT secrets - generate real random values for anything beyond local dev,
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Local file storage for task attachments
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Voice / Zoom calls (optional). Create a "Server-to-Server OAuth" app at
# https://marketplace.zoom.us with the meeting:write scope and paste its credentials here.
# Leave empty to keep calls disabled (the buttons then explain that Zoom isn't set up).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
